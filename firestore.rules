rules_version = '2';

// Grapeはクライアント(ブラウザ)からFirestoreへ直接アクセスしない。
// すべての読み書きはサーバー側(Firebase Admin SDK、Next.jsのServer Actions/
// Server Components)経由で行い、Admin SDKはこのルールをバイパスする。
// そのため、外部(クライアントSDK)からのアクセスは明示的にすべて拒否する。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
