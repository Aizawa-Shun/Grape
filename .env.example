# Copy to .env and fill in. Every value here has a working default except the
# credentials, so a fresh checkout runs after:
#
#   cp -n .env.example .env      # -n: never clobber an .env you already have
#
# LLM_PROVIDER below is the one line worth checking before a first run — the
# default needs an Anthropic key, and a machine set up for a local model wants
# `ollama` instead.

# --- Database ---------------------------------------------------------------
# A local file needs nothing else. Point this at a libsql://...-turso.io URL
# instead (`turso db show <name>`) and also set DATABASE_AUTH_TOKEN
# (`turso db tokens create <name>`) to use Turso — the same setup as Render.
DATABASE_URL=file:./grape.db
# DATABASE_AUTH_TOKEN=...

# --- Intelligence layer -----------------------------------------------------
# anthropic | ollama | openai-compat
LLM_PROVIDER=anthropic

# Leave ANTHROPIC_API_KEY unset to use an `ant auth login` profile instead.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# How long to wait for a model before giving up. Generous, because a 1.5B model
# on a CPU-only machine legitimately needs a minute to read a long prompt — the
# point is that a stalled request cannot hang forever with the page just
# spinning. The health check uses its own short timeout so /api/health still
# answers when the model is wedged.
LLM_TIMEOUT_MS=120000
LLM_HEALTH_TIMEOUT_MS=5000

# How many times to re-ask when a model returns output that will not parse.
# Small local models drop a token now and then and one retry usually fixes it;
# a model that has broken the grammar twice is unlikely to fix it on a third
# try, and each attempt costs another full prompt evaluation.
LLM_MAX_REPAIRS=1

# Ceiling on estimated AI spend per calendar month, in USD, across every call
# (extraction, diagnosis, generation). Ollama has no bill, so this only bites
# anthropic and openai-compat. Once this month's estimated spend reaches it,
# further calls are refused until the 1st — raise it from /settings, no
# restart needed.
LLM_MONTHLY_BUDGET_USD=10

# Local models. Measured on a 4-core mobile CPU / 8 GB RAM / no discrete GPU:
# a 4B reasoning model (qwen3:4b) took over 5 minutes just to *process* a
# ~900-token prompt, before generating anything — CPU prompt-eval, not
# generation, is the bottleneck on hardware like this. A 1.5B instruct model
# is the practical default here; a machine with a GPU or more cores can afford
# qwen3:4b or larger. Kept working either way so the provider swap is real,
# not aspirational.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# Any OpenAI-compatible endpoint: OpenAI, LM Studio, vLLM, llama.cpp server.
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Data layer -------------------------------------------------------------
# Public origin the tracking snippet posts to. Grape runs on localhost, but the
# snippet runs in a browser on the open internet, so this must be reachable from
# outside. During development:
#
#   cloudflared tunnel --url http://localhost:3000
#
# then paste the printed https://*.trycloudflare.com URL here. It changes every
# time the tunnel restarts, which is why Grape regenerates the snippet on demand
# rather than asking you to write it down once.
INGEST_BASE_URL=http://localhost:3000

# Sessions needed before conversion rates mean anything. Under this, diagnosis
# switches to a static audit of the site instead of reading an empty funnel.
COLD_START_MIN_SESSIONS=30

# Events older than this are deleted. /api/collect has no authentication and
# cannot have any — the product id is public, printed in the snippet on your
# own site — so it is an unbounded write path without a ceiling on it. Pruning
# runs opportunistically on about one request in a thousand; `pnpm db:prune`
# does it on demand.
GRAPE_EVENT_RETENTION_DAYS=180

# --- Operations -------------------------------------------------------------
# debug | info | warn | error. One JSON line per request, or a human-readable
# line when running in a terminal. Set to debug when you need to see what a
# model actually returned.
GRAPE_LOG_LEVEL=info

# --- Access -----------------------------------------------------------------
# The tracking snippet needs a public origin, so `pnpm tunnel` exposes this
# whole app — the Product Context, the funnel, and the button that spends money
# posting to X — not just the ingest endpoint.
#
# Signs the session cookie, and so decides whether there can be sessions at
# all. Leave it unset and `pnpm dev` still works: on localhost, in a
# development build, Grape signs itself in as a development account. Anywhere
# else — a tunnel, a deployment — unset means every page answers 503 telling
# you to set this. /api/collect and /g.js stay public either way, because the
# snippet on your site has to reach them.
#
# Generate one with: node -e "console.log(crypto.randomUUID())"
# GRAPE_SESSION_SECRET=

# There is no admin password. Accounts have their own: the first person to open
# a fresh Grape registers the owner account, registration closes behind them,
# and anyone else needs an invitation the owner issues from inside. If you
# forget yours: pnpm db:reset-password <email> '<new password>'

# --- Action layer -----------------------------------------------------------
# Posting to X is irreversible and metered: roughly $0.015 per post, ~$0.20 if
# the post contains a link, since X removed the free tier in Feb 2026. Almost
# every growth post contains a link.
#
# Dry run stays ON unless this is EXACTLY "false" — a typo must not start
# publishing to a real account.
GRAPE_ACTION_DRY_RUN=true

# From the X developer portal, for your own account. No OAuth flow is needed
# because Grape is single-user. Set the app's User authentication settings to
# "Read and Write" FIRST, then regenerate the access token — tokens issued
# before the permission change stay read-only and fail with a 403.
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
