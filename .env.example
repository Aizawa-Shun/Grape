# このファイルをコピーして .env.local を作成し、値を設定してください。
# .env.local はコミットされません(.gitignore を参照)。

# --- Firebase (Firestore) ---
# ローカル開発: 任意のプロジェクトID(Firestoreエミュレータが使用)
# Firebase App Hosting: 設定不要(Application Default Credentials で自動認証)
# (任意) FIREBASE_PROJECT_ID=grape-growth-os

# --- AI機能(Phase 3: Product Intelligence 以降) ---
# 使用するLLMプロバイダ。現時点では "anthropic" のみ想定。
LLM_PROVIDER=anthropic

# https://console.anthropic.com/ で発行した公開APIキー。
#
# 注意1: Claude Code等が使う内部トークンは公開APIでは 401 になる。必ず自分で発行したキーを使う。
# 注意2: シェルの環境変数は .env.local より優先される。
#        すでに ANTHROPIC_API_KEY をexportしている環境では、
#        `unset ANTHROPIC_API_KEY` してから起動しないと .env.local の値が使われない。
ANTHROPIC_API_KEY=

# --- アクセス制御(任意) ---
# 簡易アクセス制御用の管理者パスワード。未設定の場合はローカルアクセスのみを想定。
GRAPE_ADMIN_PASSWORD=
