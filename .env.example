# Copy to .env and fill in. Every value here has a working default except the
# credentials, so a fresh checkout runs after:
#
#   cp -n .env.example .env      # -n: never clobber an .env you already have
#
# LLM_PROVIDER below is the one line worth checking before a first run — the
# default needs an Anthropic key, and a machine set up for a local model wants
# `ollama` instead.

# --- Database ---------------------------------------------------------------
DATABASE_URL=file:./grape.db

# --- Intelligence layer -----------------------------------------------------
# anthropic | ollama | openai-compat
LLM_PROVIDER=anthropic

# Leave ANTHROPIC_API_KEY unset to use an `ant auth login` profile instead.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# Local models. Measured on a 4-core mobile CPU / 8 GB RAM / no discrete GPU:
# a 4B reasoning model (qwen3:4b) took over 5 minutes just to *process* a
# ~900-token prompt, before generating anything — CPU prompt-eval, not
# generation, is the bottleneck on hardware like this. A 1.5B instruct model
# is the practical default here; a machine with a GPU or more cores can afford
# qwen3:4b or larger. Kept working either way so the provider swap is real,
# not aspirational.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# Any OpenAI-compatible endpoint: OpenAI, LM Studio, vLLM, llama.cpp server.
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Data layer -------------------------------------------------------------
# Public origin the tracking snippet posts to. Grape runs on localhost, but the
# snippet runs in a browser on the open internet, so this must be reachable from
# outside. During development:
#
#   cloudflared tunnel --url http://localhost:3000
#
# then paste the printed https://*.trycloudflare.com URL here. It changes every
# time the tunnel restarts, which is why Grape regenerates the snippet on demand
# rather than asking you to write it down once.
INGEST_BASE_URL=http://localhost:3000

# Sessions needed before conversion rates mean anything. Under this, diagnosis
# switches to a static audit of the site instead of reading an empty funnel.
COLD_START_MIN_SESSIONS=30

# --- Action layer -----------------------------------------------------------
# Posting to X is irreversible and metered: roughly $0.015 per post, ~$0.20 if
# the post contains a link, since X removed the free tier in Feb 2026. Almost
# every growth post contains a link.
#
# Dry run stays ON unless this is EXACTLY "false" — a typo must not start
# publishing to a real account.
GRAPE_ACTION_DRY_RUN=true

# From the X developer portal, for your own account. No OAuth flow is needed
# because Grape is single-user. Set the app's User authentication settings to
# "Read and Write" FIRST, then regenerate the access token — tokens issued
# before the permission change stay read-only and fail with a 403.
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
