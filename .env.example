# このファイルをコピーして .env.local を作成し、値を設定してください。
# .env.local はコミットされません(.gitignore を参照)。

# --- Firebase (Firestore) ---
# サーバー専用のAdmin SDK認証情報。Firebase Console >
# プロジェクトの設定 > サービスアカウント > 新しい秘密鍵の生成 で取得したJSONから
# 以下の3つの値を転記する(JSONファイル自体はコミットしないこと)。
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 改行は \n のままダブルクォートで囲んで1行にする(JSON内の値をそのままコピー)
FIREBASE_PRIVATE_KEY=""

# --- AI機能 ---
# 使用するLLMプロバイダ。現時点では "anthropic" のみ想定。
LLM_PROVIDER=anthropic

# 上記プロバイダのAPIキー。Claude Code内部トークンではなく、
# https://console.anthropic.com/ で発行した公開APIキーを設定すること。
ANTHROPIC_API_KEY=

# --- アクセス制御(任意) ---
# 簡易アクセス制御用の管理者パスワード。未設定の場合はローカルアクセスのみを想定。
GRAPE_ADMIN_PASSWORD=
