# Copy to .env and fill in. Every value here has a working default except the
# credentials, so a fresh checkout runs with the Firebase emulators after:
#
#   cp -n .env.example .env      # -n: never clobber an .env you already have
#   pnpm dev:emulators
#
# On Firebase App Hosting these are set in apphosting.yaml (and secrets with
# `firebase apphosting:secrets:set`), not from this file.
#
# AI is opt-in and off by default (see LLM_PROVIDER below) — a fresh checkout
# reads sites with the rule-based fallback, not a model.

# --- Firebase ---------------------------------------------------------------
# The database is Firestore and sign-in is Firebase Authentication. Locally,
# `pnpm dev:emulators` runs both as emulators (needs Java 11+) and sets
# FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST itself, so nothing
# below is needed for that. Plain `pnpm dev` talks to a real project instead:
# run `gcloud auth application-default login` and set these two.
#
# FIREBASE_PROJECT_ID=your-project-id
#
# The web app config from the Firebase console (Project settings → Your apps →
# Web app → SDK setup and configuration → Config), as one line of JSON. Not a
# secret — it only names the project. App Hosting provides it automatically.
# FIREBASE_WEBAPP_CONFIG={"apiKey":"...","authDomain":"your-project-id.firebaseapp.com","projectId":"your-project-id","appId":"..."}

# --- Intelligence layer -----------------------------------------------------
# Unset (the default) means no AI at all: product understanding falls back to
# a rule-based reading of the page (core/context/extract.ts), and diagnosis,
# task recommendation and artifact generation simply refuse until a provider
# is chosen. This only picks *which* service and model Grape talks to —
# there is no API key to set here any more. Each account brings its own,
# from /account once signed in, so the same instance can have several people
# each calling the model on their own key and their own bill.
#
# anthropic | openai-compat
# LLM_PROVIDER=anthropic

ANTHROPIC_MODEL=claude-opus-5

# How long to wait for a model before giving up. Generous, because a slow or
# heavily-loaded endpoint legitimately needs a minute to read a long prompt —
# the point is that a stalled request cannot hang forever with the page just
# spinning. The health check uses its own short timeout so /api/health still
# answers when the model is wedged.
LLM_TIMEOUT_MS=120000
LLM_HEALTH_TIMEOUT_MS=5000

# How many times to re-ask when a model returns output that will not parse.
# Small models drop a token now and then and one retry usually fixes it; a
# model that has broken the grammar twice is unlikely to fix it on a third
# try, and each attempt costs another full prompt evaluation.
LLM_MAX_REPAIRS=1

# Ceiling on estimated AI spend per calendar month, in USD, across every call
# (extraction, diagnosis, generation). Once this month's estimated spend
# reaches it, further calls are refused until the 1st — raise it from
# /settings, no restart needed.
LLM_MONTHLY_BUDGET_USD=10

# Any OpenAI-compatible endpoint: OpenAI, or a self-hosted server (LM Studio,
# vLLM, llama.cpp server) that speaks the same API. No key here either — a
# local endpoint needs none, and a remote one authenticates with whichever
# account's own key /account has on file, same as ANTHROPIC_MODEL above.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Data layer -------------------------------------------------------------
# Public origin the tracking snippet posts to. When deployed, leave it unset:
# Grape uses the host the request came in on. Locally the snippet runs in a
# browser on the open internet, so it must be reachable from outside:
#
#   cloudflared tunnel --url http://localhost:3000
#
# then paste the printed https://*.trycloudflare.com URL here. It changes every
# time the tunnel restarts, which is why Grape regenerates the snippet on demand
# rather than asking you to write it down once.
# INGEST_BASE_URL=https://xxxx.trycloudflare.com

# Sessions needed before conversion rates mean anything. Under this, diagnosis
# switches to a static audit of the site instead of reading an empty funnel.
COLD_START_MIN_SESSIONS=30

# Events older than this are deleted. /api/collect has no authentication and
# cannot have any — the product id is public, printed in the snippet on your
# own site — so it is an unbounded write path without a ceiling on it. Pruning
# runs opportunistically on about one request in a thousand; `pnpm db:prune`
# does it on demand.
GRAPE_EVENT_RETENTION_DAYS=180

# --- Operations -------------------------------------------------------------
# debug | info | warn | error. One JSON line per request, or a human-readable
# line when running in a terminal. Set to debug when you need to see what a
# model actually returned.
GRAPE_LOG_LEVEL=info

# --- Access -----------------------------------------------------------------
# There is no admin password. The first account to sign in becomes the owner,
# registration closes behind them, and anyone else needs an invitation code the
# owner issues from /account. Forgot a password: "パスワードを忘れた" on /login
# sends a reset e-mail (in the Auth emulator, the link shows in its UI).
#
# Encrypts each account's own AI API keys in the database. Required in
# production; a development build falls back to a fixed key. Changing it makes
# stored keys unreadable, and each account then enters its key again.
# At least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GRAPE_ENCRYPTION_KEY=

# Lets a scheduler run the weekly loop: POST /api/cron/tick with
# "Authorization: Bearer <this>" measures tasks whose seven days are up and
# re-diagnoses products whose last diagnosis is over a week old, each on its
# owner's own API key and budget. On Firebase the Cloud Functions trigger in
# functions/ sends it. Unset disables the endpoint; `pnpm loop:tick` still
# runs the same thing by hand. At least 16 characters.
# GRAPE_CRON_SECRET=

# --- Action layer -----------------------------------------------------------
# Posting to X is irreversible and metered: roughly $0.015 per post, ~$0.20 if
# the post contains a link, since X removed the free tier in Feb 2026. Almost
# every growth post contains a link.
#
# Dry run stays ON unless this is EXACTLY "false" — a typo must not start
# publishing to a real account. Can also be flipped from /settings, which
# asks for confirmation before turning sending on — no restart needed either way.
GRAPE_ACTION_DRY_RUN=true

# From the X developer portal, for your own account. No OAuth flow is needed
# because these credentials post as one account for the whole instance. Set the app's User authentication settings to
# "Read and Write" FIRST, then regenerate the access token — tokens issued
# before the permission change stay read-only and fail with a 403.
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# Reading X for the growth loop (core/growth/sources/x.ts): searching recent
# posts for people who may need the product, and the numbers on published
# posts. Optional — the four posting credentials above are used for reads too
# when this is unset, and with neither the loop searches Hacker News and the
# open web instead (people can also paste X posts in by hand). Reads are
# metered, so each run's search is capped.
# X_BEARER_TOKEN=
X_SEARCH_MAX_RESULTS=20
